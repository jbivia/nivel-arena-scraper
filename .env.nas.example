# Copy to .env for a Synology/Docker deployment, then edit:
#
#   cp .env.nas.example .env && chmod 600 .env
#
# .env is gitignored and holds the database password; keep it mode 600. Compose
# reads this file twice -- once to interpolate ${...} in the compose file, once
# as the scraper's env_file -- so every variable here also reaches the
# container. That is why the password is defined once, in POSTGRES_PASSWORD,
# and compose.nas.yaml builds the connection URL from it.
#
# For the plain development stack on Podman, use .env.example instead.

# --- ownership of the bind mounts --------------------------------------------
# The container writes only to downloads/ and processed/, as this uid:gid. It
# must match what owns them on the host, or every download fails on permissions.
# DSM's first local user is 1026 and its `users` group is 100; check with
# `id <your-dsm-user>` over SSH. Then:
#   sudo chown -R "$PUID:$PGID" downloads processed
PUID=1026
PGID=100

# --- standalone mode (compose.nas.yaml) --------------------------------------
# Credentials for the bundled PostgreSQL. POSTGRES_USER and POSTGRES_DB are only
# read on first start, when the data volume is empty -- changing them later
# renames nothing.
POSTGRES_USER=nivel
POSTGRES_PASSWORD=CHANGEME
POSTGRES_DB=nivel

# --- satellite mode (compose.nas.tracker.yaml) -------------------------------
# Leave the above alone and set these two instead when the tracker app is the
# one that owns the database. The host is the container_name from that stack's
# compose.prod.yaml; the password is its POSTGRES_PASSWORD.
# SCRAPER_DATABASE_URL=postgres://nivel:CHANGEME@nivel-db-prod:5432/nivel
#
# The external network to join. Compose names it `<project>_default`, and under
# Container Manager the project name is whatever you typed in the UI. Confirm
# with `docker network ls`.
# NIVEL_NETWORK=nivel-arena-collection-tracker_default

# --- crawl tuning ------------------------------------------------------------
# Seconds between cards. The board site has no HTTPS listener and is somebody's
# small server; a NAS scraping unattended overnight has no reason to hurry.
SCRAPER_MIN_DELAY=5.0
SCRAPER_MAX_DELAY=10.0
