# Copy to .env (`make setup` does this) and fill in the credentials.
# .env is gitignored; keep the real password out of the repo.

# PostgreSQL connection used to track which cards have been scraped.
#
#   - from a container on the tracker's network: host `nivel-db`, port 5432
#   - from the host (psql, `make test`, a direct `python main.py` run): localhost
#
# The database itself is owned by the nivel-arena-collection-tracker stack;
# start it there (`make up`) before running the scraper.
#
# The credentials below are that stack's development defaults, straight from its
# .env.example -- `nivel:nivel`, the dev container, nothing secret. A deployment
# is the other file: see .env.nas.example, where the password has no default.
SCRAPER_DATABASE_URL=postgres://nivel:nivel@nivel-db:5432/nivel

# Same database as seen from the host. The `make repair-db` / `make import-sqlite`
# recipes prefer this one, since `nivel-db` does not resolve outside the network.
# The tracker's dev stack publishes 5432 (its POSTGRES_PORT); the NAS stack does
# not, which is why that side has no host URL.
SCRAPER_DATABASE_URL_LOCAL=postgres://nivel:nivel@localhost:5432/nivel

# Throwaway PostgreSQL for the test suite. `make test-db-up` starts one on
# 55432; leave unset and the database-backed tests skip.
# SCRAPER_TEST_DATABASE_URL=postgres://postgres:postgres@localhost:55432/postgres
